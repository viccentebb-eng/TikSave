{
  "manifest_version": 3,
  "name": "TikSave Local",
  "version": "0.3.0",
  "description": "Envía videos públicos de TikTok, YouTube, Instagram o Facebook a TikSave Local.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8173/*"],
  "action": {
    "default_title": "TikSave Local",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tiksave-local@local",
      "strict_min_version": "128.0"
    }
  }
}
