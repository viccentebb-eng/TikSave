{
  "manifest_version": 3,
  "name": "TikSave",
  "version": "0.5.0",
  "description": "Descarga videos, audio y subtítulos desde TikTok, YouTube, Instagram y Facebook con TikSave.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8173/*"],
  "action": {
    "default_title": "TikSave",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tiksave-local@local",
      "strict_min_version": "128.0"
    }
  }
}
