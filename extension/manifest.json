{
  "manifest_version": 3,
  "name": "TikSave",
  "version": "0.10.0",
  "description": "Descarga videos, imágenes, audio y subtítulos; detecta reproductores y ofrece herramientas de navegación limpia.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "tabs",
    "storage",
    "webRequest",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8173/*"
  ],
  "icons": {
    "48": "icons/tiksave.svg",
    "96": "icons/tiksave.svg"
  },
  "action": {
    "default_title": "TikSave",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/tiksave.svg",
      "96": "icons/tiksave.svg"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "clean_ads",
        "enabled": false,
        "path": "rules/clean-ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["guard-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["guard-state.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["notify.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.tiktok.com/*",
        "*://*.douyin.com/*",
        "*://*.iesdouyin.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://fb.watch/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tiksave-local@local",
      "strict_min_version": "128.0"
    }
  }
}
